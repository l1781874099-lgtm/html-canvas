{
  "name": "html-canvas-local-import",
  "version": "0.1.0-rc.1",
  "description": "Import local static HTML and ZIP websites into editable Figma Design layers",
  "main": "dist/main.js",
  "types": "dist/lib/html-to-figma/index.d.ts",
  "exports": {
    ".": "./dist/main.js",
    "./main": "./dist/main.js",
    "./browser": "./dist/browser.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev:lib": "tsc -w",
    "dev": "NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=development webpack --mode=development --watch",
    "build": "node tools/build.cjs",
    "test:local": "node local-test/zip-files-unit.cjs && node local-test/batch-ui-unit.cjs && node local-test/renderer-unit.cjs && node local-test/font-import-unit.cjs && node local-test/staged-import-unit.cjs && node local-test/image-layout-unit.cjs && node local-test/visual-paints-unit.cjs && node local-test/glyph-unit.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/l1781874099-lgtm/html-canvas.git"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@builder.io/sdk": "^1.0.40",
    "@figma/plugin-typings": "^1.73.0",
    "@material-ui/core": "^4.3.3",
    "@material-ui/icons": "^4.2.1",
    "@types/escape-html": "0.0.20",
    "@types/file-type": "^10.9.1",
    "@types/react": "^16.8.23",
    "@types/react-dom": "^16.8.5",
    "@types/spark-md5": "^3.0.1",
    "@types/traverse": "^0.6.32",
    "@types/uuid": "^8.3.4",
    "css-loader": "^3.1.0",
    "escape-html": "^1.0.3",
    "file-type": "^12.2.0",
    "html-webpack-inline-source-plugin": "0.0.10",
    "html-webpack-plugin": "^3.2.0",
    "linkedom": "^0.18.12",
    "mobx": "^5.13.0",
    "mobx-react": "^6.1.3",
    "react": "^16.8.6",
    "react-dom": "^16.8.6",
    "spark-md5": "^3.0.0",
    "style-loader": "^0.23.1",
    "ts-loader": "^6.0.4",
    "typescript": "^5.1.6",
    "typescript-declaration-webpack-plugin": "^0.1.1",
    "url-loader": "^2.1.0",
    "webpack": "^4.38.0",
    "webpack-cli": "^3.3.6"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^1.2.0",
    "@emotion/core": "^10.0.28",
    "@types/lodash": "^4.14.168",
    "@types/pako": "^1.0.1",
    "fflate": "^0.8.3",
    "lodash": "^4.17.21",
    "pako": "^1.0.11",
    "react-intl": "^5.17.2",
    "traverse": "^0.6.6",
    "uuid": "^8.3.2"
  },
